   "source": [
    "#| echo: false\n",
    "#| output: asis\n",
    "from IPython.display import display, Markdown\n",
    "\n",
    "if not ok:\n",
    "    display(Markdown(f\"*Analytics unavailable at build time: {err}*\"))\n",
    "else:\n",
    "    header = (f\"**Total page views:** {total('pageviews'):,} &nbsp;•&nbsp; \"\n",
    "              f\"**Visitors:** {total('visitors'):,}\\n\\n### Most-read posts\\n\\n\")\n",
    "    table = \"| Page | Views |\\n|---|---:|\\n\" + \"\\n\".join(\n",
    "        f\"| {TITLES.get(d['x'], d['x'])} | {d['y']:,} |\" for d in pages[:20]\n",
    "    )\n",
    "    display(Markdown(header + table))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "2417063d",
   "metadata": {},
   "outputs": [],
   "source": [
    "#| echo: false\n",
    "if ok and countries:\n",
    "    import folium, pycountry, branca.colormap as cm\n",
    "\n",
    "    def a2_to_a3(a2):\n",
    "        c = pycountry.countries.get(alpha_2=a2)\n",
    "        return c.alpha_3 if c else None\n",
    "\n",
    "    data = {a2_to_a3(d[\"x\"]): d[\"y\"] for d in countries if a2_to_a3(d[\"x\"])}\n",
    "\n",
    "    geo = requests.get(\"https://raw.githubusercontent.com/python-visualization/\"\n",
    "                       \"folium/main/examples/data/world-countries.json\",\n",
    "                       timeout=15).json()\n",
    "    for f in geo[\"features\"]:\n",
    "        f[\"properties\"][\"views\"] = data.get(f[\"id\"], 0)\n",
    "\n",
    "    scale = cm.linear.YlGnBu_09.scale(min(data.values()), max(data.values()))\n",
    "    scale.caption = \"Page views by country\"\n",
    "\n",
    "    def style_fn(feature):\n",
    "        v = data.get(feature[\"id\"])\n",
    "        return {\"fillColor\": scale(v) if v else \"#f0f0f0\",\n",
    "                \"color\": \"white\", \"weight\": 0.3, \"fillOpacity\": 0.8}\n",
    "\n",
    "    m = folium.Map(location=[20, 0], zoom_start=2, tiles=\"cartodbpositron\")\n",
    "    folium.GeoJson(geo, style_function=style_fn,\n",
    "                   tooltip=folium.GeoJsonTooltip(fields=[\"name\", \"views\"],\n",
    "                                                 aliases=[\"Country\", \"Views\"])).add_to(m)\n",
    "    scale.add_to(m)\n",
    "    m"
   ]
  }
